HOST=127.0.0.1
PORT=4173
# 配置后启用真实 AI。密钥仅保存在服务器环境，不发送到浏览器。
# 也可直接在页面“配置服务”中填写，保存后立即生效。
# 页面保存的 ai-config.json 优先于下列环境变量。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-6.1-sol
# auto：官方使用 Responses；中转默认使用 Chat Completions
AI_PROTOCOL=auto
# 旧中转可选 max_tokens
AI_TOKEN_FIELD=max_completion_tokens
# auto 不传推理参数；可选 none / low / medium / high，须模型支持
AI_REASONING=auto
# 可选：动态文章读取使用的 Edge / Chrome / Chromium 可执行文件
# BROWSER_EXECUTABLE=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe

# 云服务器部署时启用账号验证。公开注册保持关闭，由管理员在后台创建账号。
# 管理员密码至少 12 位；首次启动创建管理员，后续启动会按邮箱提升为管理员。
AUTH_REQUIRED=false
ENABLE_REGISTRATION=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_SECURE=false
ACCOUNT_DB_PATH=./data/youshu.sqlite
FREE_MONTHLY_CALLS=10
MEMBER_MONTHLY_CALLS=300
# 微信网页登录需要公开 HTTPS 域名和微信开放平台“网站应用”审核通过。
# 首次微信登录可创建账号；若希望只允许管理员先开通的账号，设置为 false。
PUBLIC_BASE_URL=
WECHAT_LOGIN_APP_ID=
WECHAT_LOGIN_APP_SECRET=
WECHAT_ALLOW_REGISTRATION=true
# 微信支付 APIv3 Native 支付；未完成配置时会员中心只展示方案，不收款。
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCHID=
WECHAT_PAY_MCH_SERIAL=
# 使用 base64 编码的商户 API 私钥 PEM、微信支付平台证书 PEM 或平台公钥 PEM。
WECHAT_PAY_MERCHANT_PRIVATE_KEY_BASE64=
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_PAY_PLATFORM_CERTIFICATE_BASE64=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_BASE64=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
# 后台可直接配置套餐；以下可选 JSON 仅用于首次启动时预设套餐价格（amountCents 为分）。
# MEMBERSHIP_PLANS_JSON=[{"id":"monthly","name":"月度会员","days":30,"credits":300,"amountCents":2990}]

# 文章库每日热点同步：北京时间每天 08:00 检查刷新；进程需持续运行。
ARTICLE_LIBRARY_TIMEZONE=Asia/Shanghai
# 可选：配置公开可访问的 RSS / Atom / JSON 订阅源，格式为 JSON 数组，最多 20 个。
# 每个订阅源只读取标题、简短摘要、时间、分类和原文链接，并整理成新的选题角度。
# 微信公众号没有默认保证可抓取的官方公开 RSS；只有可公开访问且格式受支持的订阅源才会纳入。
# ARTICLE_LIBRARY_FEEDS=[{"name":"公开资讯源","url":"https://example.com/feed.xml"}]

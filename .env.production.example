HOST=0.0.0.0
PORT=4173
AUTH_REQUIRED=true
ENABLE_REGISTRATION=false
COOKIE_SECURE=true
PUBLIC_BASE_URL=https://your-domain.example
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
ACCOUNT_DB_PATH=/app/data/youshu.sqlite
FREE_MONTHLY_CALLS=10
MEMBER_MONTHLY_CALLS=300
# WeChat website OAuth (open.wechat.com; register https://your-domain.example as the OAuth callback domain)
WECHAT_LOGIN_APP_ID=
WECHAT_LOGIN_APP_SECRET=
# Allow new accounts created by first-time WeChat login. Set false for invite-only accounts.
WECHAT_ALLOW_REGISTRATION=true
# WeChat Pay APIv3 Native QR checkout
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCHID=
WECHAT_PAY_MCH_SERIAL=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_BASE64=
WECHAT_PAY_PLATFORM_SERIAL=
# Set exactly one platform verification key: X509 certificate PEM or WeChat public-key PEM, base64-encoded.
WECHAT_PAY_PLATFORM_CERTIFICATE_BASE64=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_BASE64=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://your-domain.example/api/pay/wechat/notify
# Optional initial plans, integer cents. Admin can add/edit/suspend plans at /admin.
# MEMBERSHIP_PLANS_JSON=[{"id":"monthly","name":"月度会员","days":30,"credits":300,"amountCents":2990}]
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=REPLACE_WITH_SERVER_SIDE_MODEL_KEY
AI_MODEL=gpt-6.1-sol
AI_PROTOCOL=auto
AI_TOKEN_FIELD=max_completion_tokens
AI_REASONING=auto
